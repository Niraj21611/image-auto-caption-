generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

enum UserRole {
    USER
    ADMIN
}

enum ImageStatus {
    CAPTIONED
    REVIEWED
    APPROVED
}

model User {
    id           String         @id @default(auto()) @map("_id") @db.ObjectId
    name         String
    email        String         @unique
    password     String
    role         UserRole       @default(USER)
    createdAt    DateTime       @default(now())
    updatedAt    DateTime       @updatedAt
    UserActivity UserActivity[]
}

model UserActivity {
    id        String    @id @default(auto()) @map("_id") @db.ObjectId
    user      User      @relation(fields: [userId], references: [id])
    userId    String    @db.ObjectId
    loginAt   DateTime
    logoutAt  DateTime?
    duration  Int?
    date      DateTime
    weekStart DateTime
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
}

model ImageJob {
    id           String         @id @default(auto()) @map("_id") @db.ObjectId
    dirPath      String
    totalImages  Int
    processed    Int            @default(0)
    failed       Int            @default(0)
    status       String         @default("RUNNING")
    createdAt    DateTime       @default(now())
    updatedAt    DateTime       @updatedAt
    ImageCaption ImageCaption[]
}

model ImageCaption {
    id          String      @id @default(auto()) @map("_id") @db.ObjectId
    filePath    String      @unique
    status      ImageStatus @default(CAPTIONED)
    preCaption  String
    postCaption String?
    jobId       String?     @db.ObjectId
    Job         ImageJob?   @relation(fields: [jobId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
