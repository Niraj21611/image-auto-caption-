generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

enum UserRole {
    USER
    ADMIN
}

enum ImageStatus {
    CAPTIONED
    REVIEWED
    SKIPPED
    APPROVED
    FAILED
}

model User {
    id              String          @id @default(auto()) @map("_id") @db.ObjectId
    name            String
    email           String          @unique
    password        String
    role            UserRole        @default(USER)
    isCheckedIn     Boolean         @default(false)
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt
    UserActivity    UserActivity[]
    ImageCaption    ImageCaption[]
    ImageJob        ImageJob[]
    exportHistories ExportHistory[]
}

model UserActivity {
    id         String    @id @default(auto()) @map("_id") @db.ObjectId
    user       User      @relation(fields: [userId], references: [id])
    userId     String    @db.ObjectId
    checkInAt  DateTime
    checkOutAt DateTime?
    duration   Int? // in minutes
    date       DateTime // start of day for this session
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
}

model ImageJob {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    dirPath     String
    totalImages Int
    reviewed    Int     @default(0)
    processed   Int     @default(0)
    failed      Int     @default(0)
    status      String  @default("RUNNING")
    batchId     String?

    assignedTo   String? @db.ObjectId
    assignedUser User?   @relation(fields: [assignedTo], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    ImageCaption  ImageCaption[]
    ExportHistory ExportHistory[]
}

model ImageCaption {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    filePath     String  @unique
    openaiFileId String?

    status      ImageStatus @default(CAPTIONED)
    preCaption  String
    postCaption String?

    reviewerId String? @db.ObjectId
    reviewer   User?   @relation(fields: [reviewerId], references: [id])

    jobId String?   @db.ObjectId
    Job   ImageJob? @relation(fields: [jobId], references: [id])

    reviewedAt DateTime?
    isExported Boolean   @default(false) 
    exportedAt DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
}

model ExportHistory {
    id              String   @id @default(auto()) @map("_id") @db.ObjectId
    jobId           String   @db.ObjectId
    job             ImageJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
    destinationPath String
    exportedCount   Int
    exportedAt      DateTime @default(now())
    exportedBy      String   @db.ObjectId
    user            User     @relation(fields: [exportedBy], references: [id])
    imageIds        String[] // Array of ImageCaption IDs that were exported

    @@index([jobId])
    @@index([exportedBy])
}
